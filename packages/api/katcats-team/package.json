    "@deepseek-ai/dsh-tools": "workspace:*",
    "@deepseek-ai/dsh-llm": "workspace:*",
    "@deepseek-ai/dsh-session-reference": "workspace:*",
    "@deepseek-ai/dsh-util-time": "workspace:*"
